{
  "$schema": "node_modules/wrangler/config-schema.json",

  // The public Worker name; renaming this after the first deploy moves the
  // workers.dev URL. Custom-domain attach (docs/online/hosting_runbook.md)
  // is independent of this name.
  "name": "goliseo-online",
  "main": "src/index.ts",

  // Set to today at authoring time; see docs/online/hosting_runbook.md for
  // when to bump this. RoomDurableObject is invoked mainly through its
  // fetch() handler (the WebSocket upgrade path), which relies on the
  // WebSocket Hibernation API (ctx.acceptWebSocket, ctx.getWebSockets,
  // (de)serializeAttachment) -- part of the standard runtime for a long
  // time, no specific minimum compatibility_date needed for it. #599 (round
  // 2) added its one RPC method, isClaimedByHost() -- deliberately NOT a
  // fetch() branch, since a raw HTTP request can reach fetch() but not an
  // RPC method (room_durable_object.ts's own doc, "Collision probe"); this
  // compatibility_date is recent enough to support that RPC call shape.
  "compatibility_date": "2026-08-15",

  // Serves the built game (ts/dist-app/ -- see
  // docs/online/hosting_runbook.md for the exact build commands).
  // ts/public/_headers is copied
  // verbatim into that build output by Vite and sets the .wasm
  // Content-Type explicitly -- see that file's own comment for why this
  // isn't left to guesswork.
  //
  // run_worker_first routes ONLY the signaling and TURN-credential paths to
  // the Worker; every other path -- including the app shell, its JS bundle
  // and its .wasm -- is served directly from assets without invoking the
  // Worker at all.
  "assets": {
    "directory": "../ts/dist-app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/signal/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDurableObject" }]
  },

  // Two abuse guards, both per client IP (namespace_id is an arbitrary
  // caller-chosen identifier -- not a resource that needs creating on the
  // dashboard -- and only needs to stay unique within this account):
  //
  // - TURN_RATE_LIMITER: /api/turn-credentials (handleTurnCredentials)
  //   mints TURN credentials that cost money.
  // - SIGNAL_RATE_LIMITER: /signal/host and /signal/join (handleHostSignal,
  //   handleJoinSignal) each provision or address a Durable Object BEFORE
  //   any per-room check exists to catch them -- room_state.ts's own
  //   JOIN_RATE_LIMIT only throttles repeated attempts against ONE already-
  //   known code, so it does nothing against a client that mints a fresh
  //   code (and therefore a fresh billed DO) in a loop. 10/60s is well
  //   above real usage (room creation/join is a once-per-match action) and
  //   hostile to a loop.
  "ratelimits": [
    {
      "name": "TURN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "SIGNAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Ships with the first deploy (AGENTS.md-style: the migration is part of
  // this PR, not a manual dashboard step -- see docs/online/hosting_runbook.md).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],

  "observability": { "enabled": true }
}
