# Local benchmark evidence; the report in docs/ carries the reviewed numbers.
.bench/

# Native shell measurement builds (#329). The shells and their lockfiles are
# committed; the Electron runtime, the Rust build tree and the packaged
# AppImages are not — `scripts/native_shell_bench.py --build` regenerates them,
# and the numbers they produce live in docs/design/native_route_decision.md.
node_modules/
bench/native_shell/tauri/target/
# Written by tauri-build at configure time from tauri.conf.json.
bench/native_shell/tauri/gen/
# Generated by `native_shell_bench.py` (write_solid_png). Committing them would
# put the repository's first tracked image asset in the tree for three solid
# squares nothing ever displays — see THIRD_PARTY.md's audit.
bench/native_shell/tauri/icons/

# Rust host build artifacts (#327).
wasm/sim-host/target/
wasm/sim-host/dist/

# Diagnostic output from scripts/v2_frame_profile.py: a .cpuprofile, a devtools
# trace and the raw per-frame samples behind them. Evidence for one
# investigation, regenerated on demand — the CONCLUSIONS belong in code comments
# and docs/, not multi-megabyte traces in the tree.
v2-frame-profile/

# Vite's on-disk dep-optimiser cache for the out-of-workspace browser harnesses
# (their vite.config.ts sets `root` to web/, so the cache lands there).
v2/tools/*/web/.vite/
