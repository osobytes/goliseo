# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/

# Environment and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# OS / editor / local tools
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.codex/
.claude/

# Rust build tree.
rust/target/

# Node, TypeScript and the app bundle.
node_modules/
ts/node_modules/
ts/packages/*/node_modules/
ts/packages/*/dist/
ts/dist-app/
ts/**/*.tsbuildinfo

# Vite's on-disk dep-optimiser cache for the out-of-workspace browser harnesses
# (their vite.config.ts sets `root` to web/, so the cache lands there).
tools/*/web/.vite/

# Logs, coverage, profiling, and scratch output
*.log
.cache/
.tmp/
tmp/
coverage/
*.lcov
*.prof
*.trace
dist/

# Private planning and work-management material
/docs/issues/
/docs/agent_tasks.md
/docs/gameplay-gaps.md
/docs/mvp_implementation_plan.md
/docs/slice.md
/docs/design/orchestration.md
/docs/design/manager-mode.md
/docs/design/manager-mode-council-review.md
/docs/design/season_metrics.md

# Local benchmark evidence; the report in docs/ carries the reviewed numbers.
.bench/

# Diagnostic output from scripts/v2_frame_profile.py: a .cpuprofile, a devtools
# trace and the raw per-frame samples behind them. Evidence for one
# investigation, regenerated on demand — the CONCLUSIONS belong in code comments
# and docs/, not multi-megabyte traces in the tree.
v2-frame-profile/
