{
    "name": "goliseo-native-shell-electron",
    "version": "0.0.0",
    "private": true,
    "description": "Minimal Electron shell used to measure the #329 native desktop route",
    "main": "main.js",
    "license": "MIT",
    "author": "Goliseo",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --linux appimage dir"
    },
    "devDependencies": {
        "electron": "43.3.0",
        "electron-builder": "26.15.3"
    },
    "build": {
        "appId": "dev.goliseo.nativeshell",
        "productName": "goliseo-native-shell",
        "files": ["main.js", "package.json"],
        "compression": "maximum",
        "linux": {
            "target": ["appimage"],
            "category": "Game"
        }
    }
}
